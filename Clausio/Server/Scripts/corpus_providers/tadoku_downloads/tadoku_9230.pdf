        <ruby>無料<rt>むりょう</rt></ruby>の<ruby>読<rt>よ</rt></ruby>みもの
      </div>
    </a>
  </li>
  <!-- ◆youtubeで読む -->
  <li class="col-6 col-lg-3 col-xl-2 mb-3">
    <a class="d-flex flex-column text-decoration-none h-100 border bgc-l4 c-l4 px-3 py-4" href="https://www.youtube.com/playlist?list=PLECwrojQZ1wctD5oeb1AlLwxZckBmOEiY">
      <div class="">
        <i class="bi bi-youtube tdk-swiper-icon fs-iconmenu-icon" aria-hidden="true"></i>
