    {
      "sentence_id": 3,
      "japanese": "1年に4人しか棋士になれません。",
      "english_translation": "Only 4 people can become professional players each year."
    },
    {
      "sentence_id": 4,
      "japanese": "藤井聡太（ふじいそうた）は、5歳から将棋を始め、2016年に14歳2か月（中学2年生）で棋士になりました。",
      "english_translation": "Fujita Souta, who began playing shogi at the age of 5, became a professional player in 2016 at the age of 14 years and 2 months (second year of junior high school)."
    },
    {
      "sentence_id": 5,
      "japanese": "これまでで一番若い棋士でした。",
      "english_translation": "I was the youngest player to achieve this level."
