#!/bin/bash

set -euo pipefail

TUNNELBLICK_APP="/Applications/Tunnelblick.app"
VPN_NAME="vpngate_public-vpn-114.opengw.net_tcp_443"
PYTHON_BIN="python"
PRECOMPUTE_SCRIPT="weekly_precompute.py"
TIMEOUT_SECONDS=90
POLL_INTERVAL=2

log() {
  printf "[%s] %s\n" "$(date '+%H:%M:%S')" "$*"
}

tb_osascript() {
  /usr/bin/osascript <<EOF
tell application "Tunnelblick"
  $1
end tell
EOF
}

tb_state() {
  /usr/bin/osascript <<EOF
tell application "Tunnelblick"
  try
    get state of first configuration where name is "${VPN_NAME}"
  on error errMsg
    return "ERROR:" & errMsg
  end try
end tell
EOF
}

tb_has_config() {
  /usr/bin/osascript <<EOF >/dev/null
tell application "Tunnelblick"
  try
    get name of first configuration where name is "${VPN_NAME}"
  on error
    error number 1
  end try
end tell
EOF
}

cleanup_disconnect() {
  log "Disconnecting Tunnelblick config: ${VPN_NAME}"
  tb_osascript "try
    disconnect \"${VPN_NAME}\"
  end try" >/dev/null || true
}

if [[ ! -d "$TUNNELBLICK_APP" ]]; then
  echo "Tunnelblick not found at: $TUNNELBLICK_APP"
  exit 1
fi

if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
  echo "Python executable not found: $PYTHON_BIN"
  exit 1
fi

if [[ ! -f "$PRECOMPUTE_SCRIPT" ]]; then
  echo "Cannot find precompute script: $PRECOMPUTE_SCRIPT"
  echo "Run this from your Scripts directory or update PRECOMPUTE_SCRIPT."
  exit 1
fi

if ! tb_has_config; then
  echo "Tunnelblick configuration not found: ${VPN_NAME}"
  echo "Open Script Editor and verify the exact Tunnelblick config name."
  exit 1
fi

trap cleanup_disconnect EXIT

log "Connecting Tunnelblick config: ${VPN_NAME}"
tb_osascript "connect \"${VPN_NAME}\"" >/dev/null

elapsed=0
while (( elapsed < TIMEOUT_SECONDS )); do
  state="$(tb_state | tr -d '\r')"
  log "Tunnelblick state: ${state}"

  case "$state" in
    CONNECTED)
      log "VPN connected."
      break
      ;;
    ERROR:*)
      echo "Tunnelblick AppleScript error: ${state}"
      exit 1
      ;;
  esac

  sleep "$POLL_INTERVAL"
  elapsed=$((elapsed + POLL_INTERVAL))
done

final_state="$(tb_state | tr -d '\r')"
if [[ "$final_state" != "CONNECTED" ]]; then
  echo "VPN did not reach CONNECTED within ${TIMEOUT_SECONDS}s."
  echo "Final state: ${final_state}"
  exit 1
fi

log "Running weekly_precompute.py only for nhk_general"

if [ "$#" -gt 0 ]; then
  "$PYTHON_BIN" "$PRECOMPUTE_SCRIPT" --only-source nhk_general "$@"
else
  "$PYTHON_BIN" "$PRECOMPUTE_SCRIPT" --only-source nhk_general
fi

log "nhk_general precompute finished successfully."